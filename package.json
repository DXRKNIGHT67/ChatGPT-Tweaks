{
  "name": "agent-tweaks",
  "version": "2.0.0",
  "description": "Agent Tweaks \u2014 Your path for glory",
  "main": "src/main.cjs",
  "author": "Agent Tweaks",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux dir --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never --config.win.signAndEditExecutable=false",
    "test:windows": "node --test tests/windows.integration.cjs",
    "test:ui": "node tests/ui-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "playwright": "1.58.2"
  },
  "build": {
    "appId": "com.agenttweaks.desktop",
    "productName": "Agent Tweaks",
    "files": [
      "src/**/*",
      "scripts/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Agent-Tweaks-${version}-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": "dir",
      "icon": "src/icon.png"
    },
    "compression": "normal",
    "portable": {
      "artifactName": "Agent-Tweaks-${version}-${arch}-Portable.${ext}"
    }
  }
}
